# Backend environment variables
PORT=5000

# Allow the deployed frontend origin to call the contact endpoint.
CORS_ORIGIN=

# Recipient for contact form messages.
CONTACT_TO_EMAIL=karthipandi480@gmail.com

# SMTP provider settings. Keep these values in the deployment platform secrets.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Basic server-side anti-spam/rate-limit configuration.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5